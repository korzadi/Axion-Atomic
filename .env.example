OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=atomic-code:1.1
NUM_CTX=16384
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
POSTGRES_DB=axion_atomic
POSTGRES_USER=axion
POSTGRES_PASSWORD=CHANGE_THIS_BEFORE_USE
DATABASE_URL=postgresql+psycopg://axion:CHANGE_THIS_BEFORE_USE@postgres:5432/axion_atomic
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
QDRANT_API_KEY=REPLACE_WITH_QDRANT_CLOUD_API_KEY
# Mantener la colección existente hasta completar una migración/validación de datos.
QDRANT_COLLECTION=axion_atomic_knowledge
API_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
LEGACY_API_ENABLED=false
ENABLE_COMMAND_EXECUTION=false
WORKSPACE_ROOT=/workspace

# Dominio canónico de Axyron Atomic. La API y Studio comparten origen.
OAUTH_PUBLIC_BASE_URL=https://axyronatomic.com

# OAuth: usar exactamente los nombres definidos en GitHub Variables/Secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AXYRON_GITHUB_CLIENT_ID=
AXYRON_GITHUB_CLIENT_SECRET=

# SMTP transaccional: SMTP_USER (GitHub) y SMTP_USERNAME (runtime) son alias compatibles.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=

# MFA: inyectar desde el gestor de secretos/runtime; nunca guardar claves reales aquí.
# La clave activa debe aparecer una sola vez y usar KEY=VALUE (nunca KEY:VALUE).
# Las claves históricas se guardan en KEYRING como JSON literal { "key_id": "BASE64_32_BYTE_KEY" }.
# El JSON NO se codifica en Base64; cada valor de clave sí. Nunca dupliques AXYRON_MFA_ENCRYPTION_KEY_B64.
AXYRON_MFA_ENCRYPTION_KEY_ID=
AXYRON_MFA_ENCRYPTION_KEY_B64=
AXYRON_MFA_ENCRYPTION_KEYRING_B64=

# Mantener desactivado hasta validar en el runtime SMTP, MFA, HTTPS y antiabuso.
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=true

# Redis Cache (RCache) para embeddings del bot; Compose lo habilita en la red privada.
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_ENABLED=false
REDIS_EMBEDDING_CACHE_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT_SECONDS=0.35

# Backpressure para Ollama en VPS CPU: no aumentar sin pruebas de memoria y latencia.
OLLAMA_MAX_CONCURRENT=1
OLLAMA_MAX_WAITING=8
OLLAMA_QUEUE_TIMEOUT_SECONDS=20
OLLAMA_REQUEST_TIMEOUT_SECONDS=240

# Pool PostgreSQL acotado por proceso.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=1800
