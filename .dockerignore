# Never send runtime secrets or user/project data to the Docker build context.
.env
.env.*
!.env.example
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.dump
**/*.backup
backups/
workspace/
knowledge/

# Repository metadata and CI-only material.
.git/
.github/
tests/
docs/
.agents/project-context/

# Local Python/Node artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
dist/
build/
